{
  "name": "aura-battle",
  "private": true,
  "version": "1.0.0",
  "description": "AURA BATTLE — Pandung Pandung CSSHUR. One panda. Infinite aura. Zero Tailwind.",
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "vite",
    "build": "panda codegen && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "panda codegen && tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:css": "node scripts/verify-css.mjs",
    "measure": "node scripts/measure-build.mjs",
    "shoot": "node scripts/shoot.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pandacss/dev": "2.2.0",
    "@pandacss/preset-base": "2.2.0",
    "@pandacss/preset-panda": "2.2.0",
    "@pandacss/types": "2.2.0",
    "@pandacss/vite": "2.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
